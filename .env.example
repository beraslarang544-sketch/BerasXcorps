# Firebase Configuration
FIREBASE_URL=https://chatglobal-1e541-default-rtdb.asia-southeast1.firebasedatabase.app

# WhatsApp Configuration
WHATSAPP_USE_PAIRING_CODE=true
WHATSAPP_PAIRING_TIMEOUT=60
WHATSAPP_SESSION_DIR=./auth_sessions

# Proxy Configuration
PROXY_ENABLED=true
PROXY_LIST=proxies.txt

# Rate Limiting
RATE_LIMIT_HOURS=10

# Logging
LOG_LEVEL=info
LOG_FILE=logs/app.log

# API Endpoints
WHATSAPP_REPORT_URL=https://www.whatsapp.com/contact/noclient/async/new/

# API Server
API_PORT=3000
API_HOST=localhost

# Baileys Settings
BAILEYS_LOG_LEVEL=error
BAILEYS_AUTO_RECONNECT=true
