{
  "name": "beras-xcorps",
  "version": "3.2.0",
  "description": "BerasXcorps - Advanced Web Scraping & WhatsApp Automation Platform (Yarn Ready with Blast Mode)",
  "main": "src/index.js",
  "type": "module",
  "packageManager": "yarn@4.0.0",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "dev:termux": "node --watch src/index.js --termux",
    "setup": "node src/setup.js",
    "test": "jest",
    "lint": "eslint src/ --fix",
    "format": "prettier --write src/",
    "api": "node src/apiServer.js",
    "token": "node src/cli-token-generator.js",
    "check": "node src/health-check.js",
    "blast": "node src/blast-mode.js",
    "clean": "rm -rf node_modules yarn.lock",
    "reinstall": "yarn clean && yarn install",
    "hex": "node hacktools/server.js",
    "hex:install": "npm install --prefix hacktools",
    "hex:test": "node hacktools/scripts/selftest.mjs"
  },
  "keywords": [
    "scraping",
    "automation",
    "web-scraping",
    "whatsapp",
    "baileys",
    "pairing-code",
    "puppeteer",
    "axios",
    "termux",
    "firebase",
    "blast-mode",
    "mass-automation"
  ],
  "author": "BerasXcorps",
  "license": "Apache-2.0",
  "dependencies": {
    "axios": "^1.6.0",
    "baileys": "^6.3.0",
    "puppeteer": "^21.0.0",
    "cheerio": "^1.0.0",
    "chalk": "^5.3.0",
    "dotenv": "^16.3.1",
    "joi": "^17.11.0",
    "winston": "^3.11.0",
    "p-queue": "^7.3.4",
    "firebase": "^10.7.0",
    "qrcode-terminal": "^0.12.0",
    "pino": "^8.17.0",
    "express": "^4.18.2",
    "body-parser": "^1.20.2",
    "cors": "^2.8.5",
    "helmet": "^7.1.0",
    "mongoose": "^8.0.0",
    "bcryptjs": "^2.4.3",
    "jsonwebtoken": "^9.1.2",
    "express-rate-limit": "^7.1.0",
    "uuid": "^9.0.1",
    "fake-useragent": "^1.4.0",
    "cli-progress": "^3.12.0",
    "cli-table3": "^0.6.3",
    "inquirer": "^9.2.10",
    "ora": "^7.0.1",
    "bull": "^4.11.4",
    "redis": "^4.6.11",
    "socket.io": "^4.7.1"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "eslint": "^8.52.0",
    "prettier": "^3.1.0",
    "@types/node": "^20.10.0",
    "nodemon": "^3.0.2"
  },
  "engines": {
    "node": ">=18.0.0",
    "yarn": ">=4.0.0"
  }
}
